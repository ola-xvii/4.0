{
    "record": {
        "extraArgs": []
    },
    "wallpaper": {
        "postHook": "sudo /usr/share/sddm/themes/caelestia/scripts/sync.sh --posthook"
    },
    "theme": {
        "enableTerm": false,
        "enableHypr": true,
        "enableDiscord": true,
        "enableSpicetify": true,
        "enableFuzzel": true,
        "enableBtop": true,
        "enableGtk": true,
        "enableQt": true,
        "postHook": "sudo /usr/share/sddm/themes/caelestia/scripts/sync.sh --posthook"
    },
    "toggles": {
        "communication": {
            "discord": {
                "enable": true,
                "match": [{ "class": "discord" }],
                "command": ["discord"],
                "move": true
            },
            "whatsapp": {
                "enable": true,
                "match": [{ "class": "com.rtosta.zapzap" }],
                "command": ["flatpak", "run", "com.rtosta.zapzap"],
                "move": true
            }
        },
        "music": {
            "spotify": {
                "enable": true,
                "match": [{ "class": "Spotify" }, { "initialTitle": "Spotify" }, { "initialTitle": "Spotify Free" }],
                "command": ["spicetify", "watch", "-s"],
                "move": true
            },
            "feishin": {
                "enable": true,
                "match": [{ "class": "feishin" }],
                "move": true
            }
        },
        "sysmon": {
            "btop": {
                "enable": true,
                "match": [{ "class": "kitty", "title": "btop", "workspace": { "name": "special:sysmon" } }],
                "command": ["kitty", "-e", "btop"]
            }
        },
        "todo": {
            "todoist": {
                "enable": true,
                "match": [{ "class": "Todoist" }],
                "command": ["todoist"],
                "move": true
            },
            "obsidian": {
                "enable": true,
                "match": [{ "title": "Obsidian", "class": "obsidian" }],
                "command": ["obsidian"],
                "move": true
            }
        }
    }
}
