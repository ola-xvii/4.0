# ====================
#   Ghostty Config   # CaskaydiaCove - Electroharmonix
# ====================
font-family = JetBrainsMono Nerd Font Propo
font-size = 15
 
background =  #000000
background-opacity = 0.80

window-padding-x = 5
window-padding-y = 5

#[ Cursor - #FFFF33 - #00CCFF - #FF6C00 - #39FF14 - #B026FF - #FF073A ]
cursor-color = #FF6C00
cursor-text = #000000

#[ MISC ]
gtk-single-instance = true
window-decoration = false
confirm-close-surface = false

#[ THEMES - axgruv / Earthsong / Gruvbox Material Dark | Matte Black - Mathias - TokyoNight Night] 
theme = "Earthsong"

#[ Shaders_Main ]
# custom-shader = ./shaders/bloom025.glsl
custom-shader = ./shaders/cursor_smear_fade.glsl
custom-shader = ./shaders/cursor_blaze_no_trail.glsl
custom-shader = ./shaders/ripple_rectangle_cursor.glsl

# [ Keybindings ]
keybind = ctrl+space>r=reload_config

keybind = ctrl+space>n=new_window
keybind = ctrl+space>t=new_tab
keybind = ctrl+space>q=close_tab
